# 服务端口（默认 3001）
SERVER_PORT=3001

# 监听地址：
#   - 0.0.0.0：允许同局域网内的手机 / 设备访问（默认，用于移动端联调）
#   - 127.0.0.1：仅本机
SERVER_HOST=0.0.0.0

# HTTPS 证书（可选）。
# 仅当同时提供 cert + key 时才会以 HTTPS 启动，否则走 HTTP。
# 手机端访问摄像头 / 麦克风必须走 HTTPS，建议至少用自签名证书。
# 推荐使用 mkcert（https://github.com/FiloSottile/mkcert）：
#   mkcert -install
#   mkcert localhost 127.0.0.1 192.168.1.10
SERVER_CERT_FILE=./certs/localhost.pem
SERVER_KEY_FILE=./certs/localhost-key.pem

# 前端构建产物目录（可选）。
# 用于让后端同时托管前端静态资源（手机/桌面都直接访问同一个 HTTPS 入口）。
# 默认为仓库根下的 frontend/dist（相对 backend/）。
# 当你把前端 build 产物放在其它位置时才需要显式设置：
#   SERVER_FRONTEND_DIR=/absolute/path/to/frontend/dist

# 火山引擎 Ark API（豆包多模态）
ARK_API_KEY=your_ark_api_key_here
ARK_MODEL_ENDPOINT=your_ark_model_endpoint_here

# 火山引擎 TTS（可选，未配置时前端使用浏览器内置 TTS 回退）
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_CLUSTER=
VOLC_TTS_VOICE_TYPE=
