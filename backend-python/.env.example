# 服务配置
SERVER_PORT=8000
SERVER_HOST=0.0.0.0

# 火山引擎 Ark API — 主对话模型（多模态，必填）
ARK_API_KEY=
ARK_MODEL_ENDPOINT=

# 多 Key 轮转（可选，逗号分隔，不填则使用单 ARK_API_KEY）
ARK_API_KEYS=

# 摘要模型（可选，纯文本小模型，比多模态便宜）
# 不填时自动复用主模型
ARK_SUMMARY_API_KEY=
ARK_SUMMARY_MODEL_ENDPOINT=

# 火山引擎 TTS（可选）
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_CLUSTER=volcano_tts
VOLC_TTS_VOICE_TYPE=BV001_streaming

# Redis（必填）
REDIS_URL=redis://localhost:6379/0

# PostgreSQL（历史会话浏览功能需要，不填时主流程不受影响）
# 配置后需先执行 scripts/init_db.sql 初始化表结构
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_talking
